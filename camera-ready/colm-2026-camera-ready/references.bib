  keywords = {65C05 65C60 60F05 82B80,Mathematics - Numerical Analysis,Mathematics - Probability,Mathematics - Statistics Theory,Physics - Data Analysis Statistics and Probability},
  file = {/home/jsefas/Zotero/storage/YYUQL5RT/Chatterjee and Diaconis - 2017 - The sample size required in importance sampling.pdf}
