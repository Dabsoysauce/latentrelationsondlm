  keywords = {Biomedical Research,Data Interpretation Statistical,estimation,Humans,meta-analysis,Psychology,replication,research integrity,research methods,statistical analysis,Statistics as Topic,the new statistics}
}

@misc{cunninghamSparseAutoencodersFind2023,
